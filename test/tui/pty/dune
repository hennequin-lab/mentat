; The live tool-through-permission test is opt-in: it skips (exit 0) unless
; MENTAT_TUI_LIVE_TEST is set, so it stays on the runtest alias while keeping
; CI hermetic. Enable with [MENTAT_TUI_LIVE_TEST=1 dune test test/tui/pty].

(rule
 (alias runtest)
 (deps
  %{bin:mentat}
  ../../blackbox/bin/mentat_fake_provider_server.exe
  test_tool_permission_live.exe)
 (action
  (setenv
   MENTAT_BIN
   %{bin:mentat}
   (setenv
    MENTAT_FAKE_PROVIDER_BIN
    %{dep:../../blackbox/bin/mentat_fake_provider_server.exe}
    (run ./test_tool_permission_live.exe)))))
