; Complete-screen visual goldens for the next TUI. Each feature executable
; drives the real Elm shell under Mosaic's headless Matrix backend and prints
; every terminal row; expectations are intentionally human-reviewable frames.

(executable
 (name test_goal)
 (modules test_goal)
 (libraries
  mentat_digest
  mentat_diagnostic
  mentat_llm
  lpath
  mentat_permission
  mentat_protocol
  mentat_sandbox
  mentat_session
  tui_harness
  windtrap)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (alias runtest)
 (deps test_goal.exe)
 (action
  (progn
   (run ./test_goal.exe)
   (diff? test_goal.ml test_goal.ml.corrected))))

