; The verified model of lpath's canonicalization and containment, as OCaml
; extracted from theories/lpath/Lpath.v and promoted here on every build. The
; differential test in the parent directory checks this generated model against
; the real lpath over generated path strings, establishing that the model — and
; so the machine-checked laws — faithfully mirrors the implementation. Never
; edit it; change the theory and rebuild.

(library
 (name lpath_model)
 (modules lpath_model))

(rule
 (mode promote)
 (action
  (copy ../../../../theories/lpath/extract/lpath_model.ml lpath_model.ml)))

(rule
 (mode promote)
 (action
  (copy ../../../../theories/lpath/extract/lpath_model.mli lpath_model.mli)))
