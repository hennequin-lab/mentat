; The verified kernel, kept apart from the handwritten modules: everything in
; this directory is OCaml extracted from theories/mutation/Revertability.v and
; promoted here on every build, so the generated code is versioned and
; reviewable. Never edit it; change the theory and rebuild.

(library
 (name mentat_mutation_kernel)
 (modules revertability))

(rule
 (mode promote)
 (action
  (copy ../../../theories/mutation/extract/revertability.ml revertability.ml)))

(rule
 (mode promote)
 (action
  (copy
   ../../../theories/mutation/extract/revertability.mli
   revertability.mli)))
