; The verified kernel, kept apart from the handwritten modules: everything in
; this directory is OCaml extracted from theories/session/Replay.v and promoted
; here on every build, so the generated code is versioned and reviewable. Never
; edit it; change the theory and rebuild.

(library
 (name mentat_session_kernel)
 (modules replay))

(rule
 (mode promote)
 (action
  (copy ../../../theories/session/extract/replay.ml replay.ml)))

(rule
 (mode promote)
 (action
  (copy ../../../theories/session/extract/replay.mli replay.mli)))
