; The verified kernel, kept apart from the handwritten modules: everything in
; this directory is OCaml extracted from theories/sandbox/Confinement.v and
; promoted here on every build, so the generated code is versioned and
; reviewable. Never edit it; change the theory and rebuild.

(library
 (name mentat_sandbox_kernel)
 (modules confinement))

(rule
 (mode promote)
 (action
  (copy ../../../theories/sandbox/extract/confinement.ml confinement.ml)))

(rule
 (mode promote)
 (action
  (copy ../../../theories/sandbox/extract/confinement.mli confinement.mli)))
