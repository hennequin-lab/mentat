; The verified kernel, kept apart from the handwritten modules: everything in
; this directory is OCaml extracted from theories/permission/Decision.v and
; promoted here on every build, so the generated code is versioned and
; reviewable. Never edit it; change the theory and rebuild.

(library
 (name mentat_permission_kernel)
 (modules decision))

(rule
 (mode promote)
 (action
  (copy ../../../theories/permission/extract/decision.ml decision.ml)))

(rule
 (mode promote)
 (action
  (copy ../../../theories/permission/extract/decision.mli decision.mli)))
