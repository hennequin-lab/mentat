# Mentat overlay additions. Dune's installed-theory scan cannot mark a boot
# library outside an opam-style install, so Corelib is republished under its
# theory name in user-contrib, where the ROCQPATH scan resolves it by name
# for theories declaring (no_corelib) + (theories Corelib).
install: [
  ["mkdir" "-p" "%{lib}%/coq/user-contrib"]
  ["cp" "-RL" "_build/install/default/lib/coq/theories" "%{lib}%/coq/user-contrib/Corelib"]
  # The graft and the stable discovery link must carry the final package
  # path, but install actions see the build-sandbox path; the final path is
  # the same with the .sandbox/<hash> segment removed.
  ["sh" "-c" """
final_lib="$(echo '%{lib}%' | sed 's|_build/.sandbox/[^/]*/_private|_build/_private|')"
workspace_root="${final_lib%%/_build/_private/*}"
# Stable discovery root for dune's ROCQPATH scan (see dune-workspace);
# _rocq is generated per-checkout state, gitignored by the _*/ rule.
